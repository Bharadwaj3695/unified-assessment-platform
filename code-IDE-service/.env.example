# UAP Code IDE & Execution Service Environment Configuration
PORT=5050
NODE_ENV=development

# Internal Service-to-Service Secret Authentication Key
INTERNAL_API_KEY=dev_uap_exec_internal_secret_key_32bytes!!
EXECUTION_SERVICE_API_KEY=dev_uap_exec_internal_secret_key_32bytes!!

# Docker Engine Socket Path (for container orchestration)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Redis Queue & Worker Decoupling
REDIS_HOST=uap-redis
REDIS_PORT=6379
REDIS_PASSWORD=
USE_REDIS_QUEUE=true

# Resource & Execution Ceilings
DEFAULT_TIMEOUT_MS=2000
MAX_TIMEOUT_MS=10000
DEFAULT_MEMORY_MB=256
MAX_MEMORY_MB=512
DEFAULT_CPUS=1.0
MAX_OUTPUT_BYTES=65536
MAX_PIDS=64
MAX_CONCURRENT_JOBS=10
LOG_LEVEL=info

# Ephemeral Runner Images
RUNNER_IMAGE_PYTHON=uap-runner-python:3.11-alpine
RUNNER_IMAGE_JAVASCRIPT=uap-runner-node:20-alpine
RUNNER_IMAGE_SQLITE=uap-runner-sqlite:3.45-alpine

# Legacy Relational SQL Engines (Preserved under 'docker compose --profile sql-legacy up')
POSTGRES_HOST=uap-postgres-engine
POSTGRES_PORT=5432
POSTGRES_USER=uap_sql_admin
POSTGRES_PASSWORD=dev_postgres_password_uap
POSTGRES_DB=uap_sql_sandbox

MYSQL_HOST=uap-mysql-engine
MYSQL_PORT=3306
MYSQL_USER=uap_sql_admin
MYSQL_PASSWORD=dev_mysql_password_uap
MYSQL_DB=uap_sql_sandbox
