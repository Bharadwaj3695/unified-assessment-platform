# UAP Independent Execution Worker Dockerfile
# Responsibilities: Consumes jobs from Redis and coordinates ephemeral runner containers
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache curl

COPY package*.json ./
RUN npm ci --omit=dev

COPY src/ ./src/

ENV NODE_ENV=production \
    DOCKER_SOCKET_PATH=/var/run/docker.sock

CMD ["node", "src/workers/worker.js"]
