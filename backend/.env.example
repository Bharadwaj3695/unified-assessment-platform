PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas / MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/unified_assessment?retryWrites=true&w=majority

# Security & Tokens
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Logging
LOG_LEVEL=info

# Institutional Admin Provisioning Key
ADMIN_REGISTRATION_KEY=ADMIN-UAP-2025

# SMTP Email Service Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM="Unified Assessment Platform" <no-reply@uap.edu>
