PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas / MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/unified_assessment?retryWrites=true&w=majority

# Security & Tokens
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d
MFA_CHALLENGE_SECRET=your_mfa_challenge_secret_key_change_in_production
MFA_ENCRYPTION_KEY=your_32_byte_aes256_encryption_key_here_change_in_production
MFA_CHALLENGE_EXPIRES_IN=5m

# Logging
LOG_LEVEL=info

# Institutional Admin Provisioning Key
ADMIN_REGISTRATION_KEY=ADMIN-UAP-2025

# Google SSO / OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=example.edu,mycollege.edu

# SMTP Email Service Configuration (Google SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-institutional-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_PASS=your-google-app-password
SMTP_FROM="Unified Assessment Platform" <no-reply@uap.edu>
EMAIL_FROM="Unified Assessment Platform" <no-reply@uap.edu>

